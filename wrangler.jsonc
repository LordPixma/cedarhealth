{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cedarhealth",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker is the front door for every request; it renders pages from D1,
    // handles /api and /media, and falls back to env.ASSETS.fetch() for static files.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Daily retention job (03:00 UTC) — purges intake submissions past their retention period.
  "triggers": { "crons": ["0 3 * * *"] },
  // Email a formatted copy of each intake to the clinic. Requires the domain to be
  // onboarded for Email Sending (Dashboard → Email Service → Email Sending → Onboard).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Comma-separated — every address gets a formatted copy of each intake.
    // BCC copies stay hidden from the other recipients.
    "INTAKE_EMAIL_TO": "intake@cedarhealthcare.ca, moyo@cedarhealthcare.ca, osarugue@cedarhealthcare.co.uk",
    "INTAKE_EMAIL_BCC": "samuel@mustardtreegroup.com",
    "INTAKE_EMAIL_FROM": "noreply@cedarhealthcare.ca"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cedarhealth-na",
      "database_id": "705404ed-540d-4339-92fc-8fa9a5f6987f"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "cedarhealth-media" }
  ]
}
